* text=auto

# Windows-only entry points must keep CRLF or cmd.exe misparses them.
*.cmd   text eol=crlf
*.bat   text eol=crlf
*.ps1   text eol=crlf

*.py    text eol=lf
*.c     text eol=lf
*.h     text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.toml  text eol=lf
*.yml   text eol=lf
*.patch text eol=lf -whitespace

*.png   binary
*.fw    binary
*.bin   binary
