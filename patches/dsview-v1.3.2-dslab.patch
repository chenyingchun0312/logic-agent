+    /* Find all DSLogic compatible devices. Firmware is never uploaded here. */
 	devices = NULL;
     devlist = NULL;
     
@@ -439,31 +439,17 @@ static GSList *scan(GSList *options)
             num++;   
 		}
         else {
-            char *firmware;
-            char *res_path = DS_RES_PATH;
