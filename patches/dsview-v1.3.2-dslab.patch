+        }
 	}
 
 	libusb_free_device_list(devlist, 0);
@@ -1316,10 +1302,17 @@ static void remove_sources(struct DSL_context *devc)
 {
     int i;
     sr_info("%s: remove fds from polling", __func__);
+    /* [dslab patch] The Windows libusb fallback uses a single fd=-1
+     * source, whose sentinel would otherwise make the loop below stop
+     * before removing it. */
+    if (devc->usbfd && devc->usbfd[0] == -1)
+        sr_source_remove(-1);
     /* Remove fds from polling. */
+    else if (devc->usbfd)
     for (i = 0; devc->usbfd[i] != -1; i++)
         sr_source_remove(devc->usbfd[i]);
     g_free(devc->usbfd);
+    devc->usbfd = NULL;
 }
 
 static void report_overflow(struct DSL_context *devc)
@@ -1354,6 +1347,11 @@ static int receive_data(int fd, int revents, const struct sr_dev_inst *sdi)
     tv.tv_sec = tv.tv_usec = 0;
     libusb_handle_events_timeout_completed(drvc->sr_ctx->libusb_ctx, &tv, &completed);
 
+    /* [dslab patch] libusb >= 1.0.24 on Windows has no pollfds; the
+     * session is driven by a dummy fd=-1 source. Do not spin at 100% CPU. */
+    if (fd < 0)
+        g_usleep(500);
+
     if (devc->trf_completed)
         devc->empty_poll_count = 0;
     else
@@ -1487,20 +1485,31 @@ static int dev_acquisition_start(struct sr_dev_inst *sdi, void *cb_data)
 
     /* setup callback function for data transfer */
     lupfd = libusb_get_pollfds(drvc->sr_ctx->libusb_ctx);
-    for (i = 0; lupfd[i]; i++);
+    /* [dslab patch] The Windows backend since libusb 1.0.24 returns NULL
