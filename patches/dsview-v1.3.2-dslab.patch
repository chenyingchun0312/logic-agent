-
-            sr_info("Install firmware bin file, device:\"%s\", file:\"%s\"", prof->model, firmware);
-
-            if (ezusb_upload_firmware(device_handle, USB_CONFIGURATION, firmware) != SR_OK){
-                sr_err("Firmware upload failed for device %s.", prof->model);
-            }
-
-            free(firmware);
