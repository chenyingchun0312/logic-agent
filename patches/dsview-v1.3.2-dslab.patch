+     * libusb events, instead of dereferencing NULL. */
+    if (lupfd) {
+        for (i = 0; lupfd[i]; i++);
+    } else {
+        i = 0;
+    }
 
     if (!(devc->usbfd = malloc(sizeof(struct libusb_pollfd) * (i + 1)))){
         sr_err("%s,ERROR:failed to alloc memory.", __func__);
     	return SR_ERR;
     }
 
-    for (i = 0; lupfd[i]; i++) {
-        sr_source_add(lupfd[i]->fd, lupfd[i]->events,
-                  dsl_get_timeout(sdi), receive_data, sdi);
-        devc->usbfd[i] = lupfd[i]->fd;
+    if (lupfd) {
+        for (i = 0; lupfd[i]; i++) {
+            sr_source_add(lupfd[i]->fd, lupfd[i]->events,
+                      dsl_get_timeout(sdi), receive_data, sdi);
+            devc->usbfd[i] = lupfd[i]->fd;
+        }
+        free(lupfd);
+    } else {
+        sr_source_add(-1, 0, dsl_get_timeout(sdi), receive_data, sdi);
     }
     devc->usbfd[i] = -1;
-    free(lupfd);
 
     wr_cmd.header.dest = DSL_CTL_START;
     wr_cmd.header.size = 0;
